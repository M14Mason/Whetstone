# Keen configuration
# Copy to .env and fill in. The app runs fully without any of these set
# (billing falls back to DEMO MODE), so you can develop with zero accounts.

# Port to run on
PORT=3000

# Where the SQLite database file lives. Defaults to ./data/keen.db
# Set this if you are on a mounted volume, or if you hit a "disk I/O error"
# (some network drives and synced folders cannot host SQLite).
DATABASE_PATH=

# Secret used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# ---------------------------------------------------------------
# Stripe (optional). Leave blank to run in DEMO MODE, where upgrades
# are simulated locally and no real money moves.
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs, created in the Stripe dashboard.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_GROUP_SEAT_MONTHLY=

# Public URL used to build Stripe redirect links and email links.
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------
# Email (optional). Leave blank to run in CONSOLE MODE, where reset
# and verification links are printed to the server log instead of sent.
# Free tier: resend.com
# ---------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=

# ---------------------------------------------------------------
# Error monitoring (optional). Leave blank to log errors to stdout only.
# Free tier: sentry.io
# ---------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------
# Set to 1 ONLY when running behind a proxy you control (Fly, Railway, nginx).
# It makes rate limiting read X-Forwarded-For; if set without a real proxy,
# clients can forge that header and bypass rate limits entirely.
TRUST_PROXY=

# Where scripts/backup.js writes snapshots, and how many to keep.
BACKUP_DIR=
BACKUP_KEEP=14
